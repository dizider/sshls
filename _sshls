#compdef sshls

_sshls_tags() {
    local -a tags
    tags=("${(@f)$(awk '
        /^[[:space:]]*#[[:space:]]*[Tt]ags:/ {
            sub(/^[[:space:]]*#[[:space:]]*[Tt]ags:[[:space:]]*/, "")
            n = split($0, a, /,[[:space:]]*/)
            for (i = 1; i <= n; i++) {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", a[i])
                if (a[i] != "") print a[i]
            }
        }
    ' ~/.ssh/config | sort -u)}")
    # Do not offer tags that are already on the command line.
    tags=(${tags:|used_tags})
    compadd -a tags
}

_sshls_subcommands() {
    local -a subcmds
    subcmds=(add:'add a new host to ~/.ssh/config')
    _describe 'subcommand' subcmds
    _sshls_tags
}

_sshls() {
    local -a used_tags
    used_tags=(${words[2,CURRENT-1]})
    if (( CURRENT == 2 )); then
        _sshls_subcommands
    elif [[ ${words[2]} != add ]]; then
        _sshls_tags
    fi
}

_sshls "$@"
